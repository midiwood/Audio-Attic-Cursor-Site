# Copy to .env.local on the server, or set the same keys in cPanel → Setup Node.js App → Environment variables.

NODE_ENV=production

# Public HTTPS URL of this app (no trailing slash)
BETTER_AUTH_URL=https://audioattic.phonographic.co.za
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Optional comma-separated extras if you also serve www / alternate hosts
# BETTER_AUTH_TRUSTED_ORIGINS=https://www.example.com

ADMIN_EMAIL=
ADMIN_PASSWORD=

# Dropbox (or configure in Admin → Dropbox after first login)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_UPLOAD_FOLDER=/_Business/Audio Attic/Vault

# Optional AI / mail
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
RESEND_API_KEY=
MAIL_FROM=Audio Attic <hello@yourdomain.com>
