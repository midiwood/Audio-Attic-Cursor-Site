ADMIN_EMAIL=richard@phonographic.co.za
ADMIN_PASSWORD=attic-admin
SESSION_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Production example: BETTER_AUTH_URL=https://audioattic.phonographic.co.za
# Optional: BETTER_AUTH_TRUSTED_ORIGINS=https://www.example.com

SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vQgJR4b6UY48lGyCSazAuxYHuRJKKWNnq201qX1B1hl32RhoDWFoY1ZTbBYARQEwuHCiMXy4o93ZzOD/pub?gid=316289143&single=true&output=csv
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional: override these in Admin → AI / Dropbox instead of (or in addition to) .env

# DigitalOcean Spaces (audio vault — configure in Admin → Storage)
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
DO_SPACES_REGION=nyc3
DO_SPACES_PREFIX=vault
DO_SPACES_PRESIGN_TTL_SEC=14400
# Optional CDN endpoint for presigned URLs
# DO_SPACES_CDN_ENDPOINT=https://your-bucket.nyc3.cdn.digitaloceanspaces.com

# Legacy Dropbox (migration only — remove after cutover)
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=
# DROPBOX_REFRESH_TOKEN=
# DROPBOX_UPLOAD_FOLDER=/_Business/Audio Attic/Vault

# Partner catalog search (Clear tracks only). See docs/CATALOG-PARTNER-API.md
CATALOG_API_KEY=
# Optional HMAC secret for playUrl signatures (defaults to CATALOG_API_KEY)
# CATALOG_HMAC_SECRET=

# Playlist share invites (or configure in Admin → Email)
RESEND_API_KEY=
MAIL_FROM=Audio Attic <onboarding@resend.dev>
